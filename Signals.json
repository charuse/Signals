  "name": "Signals",
  "previewIconUrl": "https://asset-resources.gdevelop.io/public-resources/Icons/a422fe56b8214e5d8b8e5ca6ad8f6b9598f89e6bd3af47c9e25d1777c2534c63_signal-variant.svg",
  "shortDescription": "Adds Call Signal as an action and On Signal Call as a condition, allowing re-use of multiple actions easily. Each signal can be called with or without a strength value.",
  "version": "1.2.2",
  "description": [
    "Allows for calling and on call signals within the Action Sheet.  ",
    "Useful for re-use of the same actions for different calls of the same signal.  ",
    "  ",
    "Write \"On Signal Call\" then use \"Call Signal\" in your program for use.  ",
    "Either can be used in front of another, On Signal Call can appear before Call Signal in the action sheet, and vice versa.  ",
    "  ",
    "Each Signal can be given its own strength value, which can be accessed with `Signals::GetStrength(\"Signal Name\")`  "
  ],
  "tags": [
    "general",
    "signals",
    "signal",
    "calls",
    "functions"
  ],
