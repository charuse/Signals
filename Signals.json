  "eventsFunctions": [
    {
      "description": "Calls a Signal.",
      "fullName": "Call Signal",
      "functionType": "Action",
      "name": "CallSignal",
      "sentence": "Call Signal _PARAM1_",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const extName = \"Signals\";",
            "const sigName = eventsFunctionContext.getArgument(\"SignalName\");",
            "globalThis[extName] = globalThis[extName] || { ",
            "    activeCalls: new Map(), incomingCalls: new Map(),",
            "    totalCalls: new Map(), signalStrengths: new Map()",
            "};",
            "globalThis[extName].incomingCalls.set(sigName, undefined);",
            "globalThis[extName].signalStrengths.set(sigName, -1);",
            "const currentCount = globalThis[extName].totalCalls.get(sigName) || 0;",
            "globalThis[extName].totalCalls.set(sigName, currentCount + 1);"
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": false
        }
      ],
      "parameters": [
        {
          "description": "Signal Name",
          "name": "SignalName",
          "supplementaryInformation": "TextObject::Text",
          "type": "string"
        }
      ],
      "objectGroups": []
    },
    {
      "description": "Reacts to a Signal call.",
      "fullName": "On Signal Call",
      "functionType": "Condition",
      "name": "OnSignalCall",
      "sentence": "Signal _PARAM1_ is called",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const extName = \"Signals\";",
            "const sigName = eventsFunctionContext.getArgument(\"SignalName\");",
            "eventsFunctionContext.returnValue = !!globalThis[extName].activeCalls.has(sigName);"
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": false
        }
      ],
      "parameters": [
        {
          "description": "Signal Name",
          "name": "SignalName",
          "type": "string"
        }
      ],
      "objectGroups": []
    },
    {
      "fullName": "",
      "functionType": "Action",
      "name": "onScenePreEvents",
      "sentence": "",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const extName = \"Signals\";",
            "globalThis[extName] = globalThis[extName] || { ",
            "    activeCalls: new Map(), ",
            "    incomingCalls: new Map(),",
            "    totalCalls: new Map(),",
            "    signalStrengths: new Map()",
            "};",
            "globalThis[extName].activeCalls = new Map(globalThis[extName].incomingCalls);",
            "globalThis[extName].incomingCalls.clear();"
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": false
        }
      ],
      "parameters": [],
      "objectGroups": []
    },
    {
      "description": "Calls a Signal with a strength value.",
      "fullName": "Call Signal with Strength",
      "functionType": "Action",
      "name": "CallSignalWithStrength",
      "sentence": "Call Signal _PARAM1_ with _PARAM2_ strength",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const extName = \"Signals\";\r",
            "const sigName = eventsFunctionContext.getArgument(\"SignalName\");\r",
            "const strength = eventsFunctionContext.getArgument(\"Strength\");\r",
            "globalThis[extName] = globalThis[extName] || { \r",
            "    activeCalls: new Map(), incomingCalls: new Map(),\r",
            "    totalCalls: new Map(), signalStrengths: new Map()\r",
            "};\r",
            "globalThis[extName].incomingCalls.set(sigName, strength);\r",
            "globalThis[extName].signalStrengths.set(sigName, strength);\r",
            "const currentCount = globalThis[extName].totalCalls.get(sigName) || 0;\r",
            "globalThis[extName].totalCalls.set(sigName, currentCount + 1);"
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": false
        }
      ],
      "parameters": [
        {
          "description": "Signal Name",
          "name": "SignalName",
          "supplementaryInformation": "TextObject::Text",
          "type": "string"
        },
        {
          "description": "Strength",
          "name": "Strength",
          "type": "expression"
        }
      ],
      "objectGroups": []
    },
    {
      "description": "Gets the current strength of a Signal.",
      "fullName": "Get Strength",
      "functionType": "Expression",
      "name": "GetStrength",
      "sentence": "",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const extName = \"Signals\";",
            "const sigName = eventsFunctionContext.getArgument(\"SignalName\");",
            "let strength = -1; ",
            "if (globalThis[extName] && globalThis[extName].signalStrengths.has(sigName)) {",
            "    strength = globalThis[extName].signalStrengths.get(sigName);",
            "}",
            "eventsFunctionContext.returnValue = strength;"
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": false
        }
      ],
      "expressionType": {
        "type": "expression"
      },
      "parameters": [
        {
          "description": "Signal Name",
          "name": "SignalName",
          "type": "string"
        }
      ],
      "objectGroups": []
    },
    {
      "description": "Gets the total amount of calls made to a Signal.",
      "fullName": "Total Calls",
      "functionType": "Expression",
      "name": "TotalCalls",
      "sentence": "",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const extName = \"Signals\";",
            "const sigName = eventsFunctionContext.getArgument(\"SignalName\");",
            "let total = 0;",
            "if (globalThis[extName] && globalThis[extName].totalCalls.has(sigName)) {",
            "    total = globalThis[extName].totalCalls.get(sigName);",
            "}",
            "eventsFunctionContext.returnValue = total;"
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": false
        }
      ],
      "expressionType": {
        "type": "expression"
      },
      "parameters": [
        {
          "description": "Signal Name",
          "name": "SignalName",
          "type": "string"
        }
      ],
      "objectGroups": []
    },
    {
      "description": "Changes a Signal's strength.",
      "fullName": "Change Signal Strength",
      "functionType": "Action",
      "name": "ChangeSignalStrength",
      "sentence": "Change strength of _PARAM1_ to _PARAM2_",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const extName = \"Signals\";",
            "const sigName = eventsFunctionContext.getArgument(\"SignalName\");",
            "const strength = eventsFunctionContext.getArgument(\"Strength\");",
            "globalThis[extName] = globalThis[extName] || { ",
            "    activeCalls: new Map(), incomingCalls: new Map(),",
            "    totalCalls: new Map(), signalStrengths: new Map()",
            "};",
            "globalThis[extName].signalStrengths.set(sigName, strength);"
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": false
        }
      ],
      "parameters": [
        {
          "description": "Signal Name",
          "name": "SignalName",
          "supplementaryInformation": "TextObject::Text",
          "type": "string"
        },
        {
          "description": "Strength",
          "name": "Strength",
          "type": "expression"
        }
      ],
      "objectGroups": []
    },
    {
      "description": "Checks if a Signal has been called.",
      "fullName": "Signal Has Been Called",
      "functionType": "Condition",
      "name": "SignalHasBeenCalled",
      "sentence": "Signal _PARAM1_ has been called",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const extName = \"Signals\";",
            "const sigName = eventsFunctionContext.getArgument(\"SignalName\");",
            "let called = false;",
            "if (globalThis[extName] && globalThis[extName].totalCalls.has(sigName)) {",
            "    if (globalThis[extName].totalCalls.get(sigName) > 0) called = true;",
            "}",
            "eventsFunctionContext.returnValue = called;"
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": false
        }
      ],
      "parameters": [
        {
          "description": "Signal Name",
          "name": "SignalName",
          "type": "string"
        }
      ],
